## 3. Busiest Day for Each Branch
```sql
WITH DayCounts AS (
            SELECT Branch, strftime('%w', date) as day_of_week, COUNT(*) as transaction_count
            FROM sales
            GROUP BY Branch, day_of_week
        ),
        RankedDays AS (
            SELECT Branch, day_of_week, transaction_count,
                   RANK() OVER (PARTITION BY Branch ORDER BY transaction_count DESC) as rank
            FROM DayCounts
        )
        SELECT Branch, 
               CASE day_of_week 
                   WHEN '0' THEN 'Sunday' WHEN '1' THEN 'Monday' WHEN '2' THEN 'Tuesday'
                   WHEN '3' THEN 'Wednesday' WHEN '4' THEN 'Thursday' WHEN '5' THEN 'Friday'
                   WHEN '6' THEN 'Saturday' END as busiest_day,
               transaction_count
        FROM RankedDays
        WHERE rank = 1;
```

