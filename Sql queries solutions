## 9. Branches with Highest Revenue Decline Year-Over-Year
```sql
WITH YearlyRevenue AS (
            SELECT Branch, strftime('%Y', date) as year, SUM(unit_price * quantity) as revenue
            FROM sales
            WHERE date IS NOT NULL
            GROUP BY Branch, year
        ),
        RevenueChanges AS (
            SELECT Branch, year, revenue,
                   LAG(revenue) OVER (PARTITION BY Branch ORDER BY year) as prev_year_revenue
            FROM YearlyRevenue
        )
        SELECT Branch, year as current_year,
               ROUND(revenue, 2) as current_revenue,
               ROUND(prev_year_revenue, 2) as previous_revenue,
               ROUND(revenue - prev_year_revenue, 2) as revenue_change
        FROM RevenueChanges
        WHERE prev_year_revenue IS NOT NULL AND (revenue - prev_year_revenue) < 0
        ORDER BY revenue_change ASC
        LIMIT 10;
```

